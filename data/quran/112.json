{"n":112,"name":"Al-Ikhlas","ar":"الإخلاص","en":"The Sincerity","pt":"A Sinceridade","place":"meccan","verses":[{"ar":"قُلۡ هُوَ ٱللَّهُ أَحَدٌ","w":["Say","He","(is) Allah","the One"],"en":"Say, \"He is Allah, [who is] One","pt":"Dize: \"Ele é Allah, Único"},{"ar":"ٱللَّهُ ٱلصَّمَدُ","w":["Allah","the Eternal, the Absolute"],"en":"Allah, the Eternal Refuge","pt":"Allah é O Solicitado"},{"ar":"لَمۡ يَلِدۡ وَلَمۡ يُولَدۡ","w":["Not","He begets","and not","He is begotten"],"en":"He neither begets nor is born","pt":"Não gerou e não foi gerado"},{"ar":"وَلَمۡ يَكُن لَّهُۥ كُفُوًا أَحَدُۢ","w":["And not","is","for Him","equivalent","any [one]"],"en":"Nor is there to Him any equivalent","pt":"E não há ninguém igual a Ele"}]}