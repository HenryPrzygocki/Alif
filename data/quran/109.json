{"n":109,"name":"Al-Kafirun","ar":"الكافرون","en":"The Disbelievers","pt":"Os Descrentes","place":"meccan","verses":[{"ar":"قُلۡ يَـٰٓأَيُّهَا ٱلۡكَٰفِرُونَ","w":["Say","O","disbelievers"],"en":"Say, \"O disbelievers","pt":"Dize: \"Ó renegadores da Fé"},{"ar":"لَآ أَعۡبُدُ مَا تَعۡبُدُونَ","w":["Not","I worship","what","you worship"],"en":"I do not worship what you worship","pt":"Não adoro o que adorais"},{"ar":"وَلَآ أَنتُمۡ عَٰبِدُونَ مَآ أَعۡبُدُ","w":["And not","you","(are) worshippers","(of) what","I worship"],"en":"Nor are you worshippers of what I worship","pt":"Nem adorareis o que adoro"},{"ar":"وَلَآ أَنَا۠ عَابِدٞ مَّا عَبَدتُّمۡ","w":["And not","I am","a worshipper","(of) what","you worship"],"en":"Nor will I be a worshipper of what you worship","pt":"Nem adorarei o que adorastes"},{"ar":"وَلَآ أَنتُمۡ عَٰبِدُونَ مَآ أَعۡبُدُ","w":["And not","you","(are) worshippers","(of) what","I worship"],"en":"Nor will you be worshippers of what I worship","pt":"Nem adorareis o que adoro"},{"ar":"لَكُمۡ دِينُكُمۡ وَلِيَ دِينِ","w":["For you","(is) your religion","and for me","(is) my religion"],"en":"For you is your religion, and for me is my religion","pt":"A vós vossa religião e, a mim, minha religião"}]}